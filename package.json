{
  "name": "muse-history-sidebar",
  "displayName": "Muse History Sidebar",
  "description": "Browse local Muse history by workspace folder with rename and a dedicated Archived view; a static, refresh-on-demand sidebar with no background processes.",
  "publisher": "AlexWonton",
  "version": "0.2.1",
  "license": "MIT",
  "engines": {
    "vscode": "^1.144.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/src/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Read-only browsing is available; opening a Muse terminal requires a trusted workspace.",
      "restrictedConfigurations": [
        "museHistory.enginePath"
      ]
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "test": "npm run compile && node --test out/test/backend*.js out/test/shared*.js out/test/ui*.js",
    "test:extension": "npm run compile && node test/run-extension.cjs",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --target win32-x64 --readme-path MARKETPLACE.md --allow-missing-repository"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "museHistory",
          "title": "Muse History",
          "icon": "media/muse.svg"
        }
      ]
    },
    "views": {
      "museHistory": [
        {
          "id": "museHistory.sessions",
          "name": "History",
          "icon": "media/muse.svg"
        },
        {
          "id": "museHistory.archived",
          "name": "Archived",
          "icon": "media/muse.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "museHistory.refresh",
        "title": "Muse: Refresh History",
        "icon": "$(refresh)"
      },
      {
        "command": "museHistory.search",
        "title": "Muse: Search Titles or Folders",
        "icon": "$(search)"
      },
      {
        "command": "museHistory.searchArchived",
        "title": "Muse: Search Archived Sessions",
        "icon": "$(search)"
      },
      {
        "command": "museHistory.chooseEngine",
        "title": "Muse: Choose Engine",
        "icon": "$(gear)"
      },
      {
        "command": "museHistory.open",
        "title": "Muse: Open Session Terminal"
      },
      {
        "command": "museHistory.preview",
        "title": "Muse: Read-only Preview"
      },
      {
        "command": "museHistory.openParent",
        "title": "Muse: Open Parent Main Session Terminal"
      },
      {
        "command": "museHistory.rename",
        "title": "Muse: Rename…"
      },
      {
        "command": "museHistory.resetName",
        "title": "Muse: Restore Original Title"
      },
      {
        "command": "museHistory.archive",
        "title": "Muse: Archive (Move to Archive Folder)"
      },
      {
        "command": "museHistory.unarchive",
        "title": "Muse: Unarchive (Move Back to Muse)"
      },
      {
        "command": "museHistory.recycle",
        "title": "Muse: Delete (Move to Windows Recycle Bin)"
      },
      {
        "command": "museHistory.emptyArchive",
        "title": "Muse: Empty Archive (Move All to Recycle Bin)",
        "icon": "$(trash)"
      },
      {
        "command": "museHistory.openArchiveFolder",
        "title": "Muse: Open Archive Folder",
        "icon": "$(folder-opened)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "museHistory.refresh",
          "when": "view == museHistory.sessions",
          "group": "navigation@1"
        },
        {
          "command": "museHistory.search",
          "when": "view == museHistory.sessions",
          "group": "navigation@2"
        },
        {
          "command": "museHistory.chooseEngine",
          "when": "view == museHistory.sessions",
          "group": "navigation@4"
        },
        {
          "command": "museHistory.refresh",
          "when": "view == museHistory.archived",
          "group": "navigation@1"
        },
        {
          "command": "museHistory.searchArchived",
          "when": "view == museHistory.archived",
          "group": "navigation@2"
        },
        {
          "command": "museHistory.openArchiveFolder",
          "when": "view == museHistory.archived",
          "group": "navigation@3"
        },
        {
          "command": "museHistory.emptyArchive",
          "when": "view == museHistory.archived",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "museHistory.preview",
          "when": "view == museHistory.sessions && viewItem =~ /session/",
          "group": "1_open@1"
        },
        {
          "command": "museHistory.open",
          "when": "view == museHistory.sessions && viewItem =~ /root/",
          "group": "1_open@2"
        },
        {
          "command": "museHistory.openParent",
          "when": "view == museHistory.sessions && viewItem =~ /child/",
          "group": "1_open@2"
        },
        {
          "command": "museHistory.rename",
          "when": "view =~ /^museHistory\\.(sessions|archived)$/ && viewItem =~ /session|archivedEntry/",
          "group": "2_manage@0"
        },
        {
          "command": "museHistory.resetName",
          "when": "view =~ /^museHistory\\.(sessions|archived)$/ && viewItem =~ /renamed/",
          "group": "2_manage@0"
        },
        {
          "command": "museHistory.archive",
          "when": "view == museHistory.sessions && viewItem =~ /session-root/",
          "group": "2_manage@1"
        },
        {
          "command": "museHistory.unarchive",
          "when": "view == museHistory.archived && viewItem =~ /archivedEntry/",
          "group": "2_manage@1"
        },
        {
          "command": "museHistory.recycle",
          "when": "view =~ /^museHistory\\.(sessions|archived)$/ && viewItem =~ /session|archivedEntry/",
          "group": "3_recycle"
        }
      ],
      "commandPalette": [
        {
          "command": "museHistory.open",
          "when": "false"
        },
        {
          "command": "museHistory.preview",
          "when": "false"
        },
        {
          "command": "museHistory.openParent",
          "when": "false"
        },
        {
          "command": "museHistory.archive",
          "when": "false"
        },
        {
          "command": "museHistory.unarchive",
          "when": "false"
        },
        {
          "command": "museHistory.recycle",
          "when": "false"
        },
        {
          "command": "museHistory.resetName",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "Muse History",
      "properties": {
        "museHistory.enginePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to the local native Muse executable. Leave empty for automatic discovery."
        }
      }
    },
    "keybindings": [
      {
        "command": "museHistory.rename",
        "key": "f2",
        "when": "focusedView == museHistory.sessions || focusedView == museHistory.archived"
      }
    ]
  },
  "dependencies": {
    "markdown-it": "15.0.3"
  },
  "devDependencies": {
    "@types/vscode": "1.144.0",
    "@types/node": "24.19.2",
    "@types/markdown-it": "14.2.0",
    "typescript": "7.0.2",
    "@vscode/vsce": "4.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Great-us/muse-history-sidebar.git"
  },
  "homepage": "https://github.com/Great-us/muse-history-sidebar",
  "bugs": {
    "url": "https://github.com/Great-us/muse-history-sidebar/issues"
  },
  "author": "Great-us",
  "keywords": [
    "history",
    "sessions",
    "workspace",
    "muse",
    "archive",
    "rename"
  ],
  "icon": "media/icon.png"
}
