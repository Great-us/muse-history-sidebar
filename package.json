{
  "name": "muse-history-sidebar",
  "displayName": "Muse History Sidebar",
  "description": "Browse local Muse history by workspace folder and open session terminals in their original working directories.",
  "publisher": "AlexWonton",
  "version": "0.1.2",
  "license": "MIT",
  "engines": {
    "vscode": "^1.144.0"
  },
  "categories": [
    "Other"
  ],
  "extensionKind": [
    "ui"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/src/extension.js",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Read-only browsing is available; opening a Muse terminal requires a trusted workspace.",
      "restrictedConfigurations": [
        "museHistory.enginePath"
      ]
    },
    "virtualWorkspaces": {
      "supported": false
    }
  },
  "scripts": {
    "compile": "tsc -p .",
    "test": "npm run compile && node --test out/test/backend*.js out/test/shared*.js out/test/ui*.js",
    "test:extension": "npm run compile && node test/run-extension.cjs",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package --target win32-x64 --readme-path MARKETPLACE.md --allow-missing-repository"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "museHistory",
          "title": "Muse History",
          "icon": "media/muse.svg"
        }
      ]
    },
    "views": {
      "museHistory": [
        {
          "id": "museHistory.sessions",
          "name": "History",
          "icon": "media/muse.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "museHistory.refresh",
        "title": "Muse: Refresh History",
        "icon": "$(refresh)"
      },
      {
        "command": "museHistory.search",
        "title": "Muse: Search Titles or Folders",
        "icon": "$(search)"
      },
      {
        "command": "museHistory.filter",
        "title": "Muse: Filter by Archive Status",
        "icon": "$(filter)"
      },
      {
        "command": "museHistory.chooseEngine",
        "title": "Muse: Choose Engine",
        "icon": "$(gear)"
      },
      {
        "command": "museHistory.open",
        "title": "Muse: Open Session Terminal"
      },
      {
        "command": "museHistory.preview",
        "title": "Muse: Read-only Preview"
      },
      {
        "command": "museHistory.openParent",
        "title": "Muse: Open Parent Main Session Terminal"
      },
      {
        "command": "museHistory.archive",
        "title": "Muse: Archive"
      },
      {
        "command": "museHistory.unarchive",
        "title": "Muse: Remove Independent Archive"
      },
      {
        "command": "museHistory.recycle",
        "title": "Muse: Move to System Recycle Bin"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "museHistory.refresh",
          "when": "view == museHistory.sessions",
          "group": "navigation@1"
        },
        {
          "command": "museHistory.search",
          "when": "view == museHistory.sessions",
          "group": "navigation@2"
        },
        {
          "command": "museHistory.filter",
          "when": "view == museHistory.sessions",
          "group": "navigation@3"
        },
        {
          "command": "museHistory.chooseEngine",
          "when": "view == museHistory.sessions",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "museHistory.preview",
          "when": "view == museHistory.sessions && viewItem =~ /session/",
          "group": "1_open@1"
        },
        {
          "command": "museHistory.open",
          "when": "view == museHistory.sessions && viewItem =~ /root/",
          "group": "1_open@2"
        },
        {
          "command": "museHistory.openParent",
          "when": "view == museHistory.sessions && viewItem =~ /child/",
          "group": "1_open@2"
        },
        {
          "command": "museHistory.archive",
          "when": "view == museHistory.sessions && viewItem =~ /session/ && !(viewItem =~ /selfArchived/)",
          "group": "2_manage@1"
        },
        {
          "command": "museHistory.unarchive",
          "when": "view == museHistory.sessions && viewItem =~ /selfArchived/",
          "group": "2_manage@1"
        },
        {
          "command": "museHistory.recycle",
          "when": "view == museHistory.sessions && viewItem =~ /session/",
          "group": "3_recycle"
        }
      ]
    },
    "configuration": {
      "title": "Muse History",
      "properties": {
        "museHistory.enginePath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to the local native Muse executable. Leave empty for automatic discovery."
        }
      }
    }
  },
  "dependencies": {
    "markdown-it": "15.0.3"
  },
  "devDependencies": {
    "@types/vscode": "1.144.0",
    "@types/node": "24.19.2",
    "@types/markdown-it": "14.2.0",
    "typescript": "7.0.2",
    "@vscode/vsce": "4.1.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Great-us/muse-history-sidebar.git"
  },
  "homepage": "https://github.com/Great-us/muse-history-sidebar",
  "bugs": {
    "url": "https://github.com/Great-us/muse-history-sidebar/issues"
  },
  "author": "Great-us",
  "keywords": [
    "history",
    "sessions",
    "workspace",
    "muse"
  ]
}
